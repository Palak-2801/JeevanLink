# Copy this file to .env and fill in what you have.
# Easier still: run  python setup_alerts.py  which tests each
# credential and writes this file for you.
#
# Never commit the real .env file.

# ---- Database -------------------------------------------------------
# Empty  = local SQLite file
# Filled = shared PostgreSQL, every device sees the same data
DATABASE_URL=

# ---- Public URL -----------------------------------------------------
PUBLIC_BASE_URL=http://127.0.0.1:5000

# ---- Channel selection ----------------------------------------------
# Comma separated: whatsapp,email,sms
# Empty = use whatever is configured below.
ALERT_CHANNELS=

# =====================================================================
#  EMAIL - pick ONE of the two options below
# =====================================================================

# ---- Option A: Resend (simplest, one key) ---------------------------
# resend.com  ->  API Keys  ->  Create
# Without your own domain, Resend delivers to the address your
# Resend account is registered with.
RESEND_API_KEY=
RESEND_FROM=JeevanLink <onboarding@resend.dev>

# ---- Option B: SMTP (Gmail, Brevo, Outlook, college server) ---------
# Gmail needs an App Password, not your normal password:
#   1. myaccount.google.com/security     turn on 2-Step Verification
#   2. myaccount.google.com/apppasswords create one, 16 characters
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# =====================================================================
#  WHATSAPP via the Twilio sandbox (free, no card)
# =====================================================================
# twilio.com  ->  Messaging  ->  Try it out  ->  Send a WhatsApp message
# Each recipient sends the join code to the sandbox number once.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ---- Real SMS (optional, needs a paid Twilio number) ----------------
TWILIO_PHONE_NUMBER=

# ---- Misc -----------------------------------------------------------
DEFAULT_COUNTRY_CODE=+91
